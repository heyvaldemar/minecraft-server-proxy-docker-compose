# Minecraft Proxy (Velocity + Geyser + Floodgate) — Environment Variables
# Copy this file to `.env` to override defaults; everything has a working
# default, so an empty .env is fine for a first run.
#
# The image version is NOT set here. The tested tag + sha256 digest lives
# in the compose file's `x-images` block, so `git pull` delivers the
# version this repository has tested. To pin differently, uncomment:
# MINECRAFT_SERVER_IMAGE_TAG=itzg/mc-proxy:2026.8.2@sha256:…

# Proxy type and memory
# MINECRAFT_SERVER_TYPE=VELOCITY
# MINECRAFT_SERVER_MEMORY=2G

# Java Edition port (Velocity) and Bedrock port (Geyser, UDP)
# MINECRAFT_SERVER_PORT=25565
# MINECRAFT_BEDROCK_SERVER_PORT=19132

# Plugins downloaded on first start (comma-separated URLs)
# MINECRAFT_SERVER_PLUGINS=https://download.geysermc.org/v2/projects/geyser/versions/latest/builds/latest/downloads/velocity,https://download.geysermc.org/v2/projects/floodgate/versions/latest/builds/latest/downloads/velocity

# Resource limits (defaults shown). Each service carries memory/CPU limits and
# reservations as compose-level defaults; override any of them here and the
# override survives every git pull. Sizing is per host: raise a limit if a
# service is OOM-killed (docker inspect shows OOMKilled=true).
# MINECRAFT_SERVER_PROXY_MEMORY_LIMIT=1g
# MINECRAFT_SERVER_PROXY_CPU_LIMIT=1.0
# MINECRAFT_SERVER_PROXY_MEMORY_RESERVATION=128m
# MINECRAFT_SERVER_PROXY_CPU_RESERVATION=0.25
